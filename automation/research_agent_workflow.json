    {
      "parameters": {
        "jsCode": "// 1. GET INPUTS\n// We use .first() because the Editor Agent outputs a single consolidated newsletter\nconst inputItem = $('Editor Agent').first();\nconst rawText = inputItem ? inputItem.json.output.content : \"\";\nconst pageId = $('Create a page').first().json.id;\n\n// Safety Check: If AI returned empty text, stop here to avoid errors\nif (!rawText) {\n  return [];\n}\n\n// 2. CHUNKING (Preserving Formatting)\n// We split by double newlines to keep paragraphs separate.\n// We do NOT use .replace() here, so Bold (**text**) and Headers (#) are kept.\nlet paragraphs = rawText.split('\\n\\n');\n\n// 3. SAFETY & SPLITTING\n// Notion has a strict 2000 character limit per block.\n// This loop checks every paragraph. If one is too big, it cuts it into smaller pieces.\nparagraphs = paragraphs.flatMap(p => {\n  if (p.length > 2000) {\n    // Split into chunks of 2000 characters\n    return p.match(/.{1,2000}/g) || [p];\n  }\n  return p;\n});\n\n// 4. CLEANUP\n// Remove empty lines that might have been created by the split\nparagraphs = paragraphs.filter(p => p && p.trim().length > 0);\n\n// 5. OUTPUT\n// Map to the format n8n expects for the next node\nreturn paragraphs.map(p => ({\n  json: {\n    text_chunk: p.trim(),\n    page_id: pageId\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
