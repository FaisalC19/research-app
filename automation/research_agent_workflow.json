        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"title\": {\n      \"type\": \"string\",\n      \"description\": \"A catchy, professional main headline for this newsletter edition.\"\n    },\n    \"content\": {\n      \"type\": \"string\",\n      \"description\": \"The complete newsletter body text in valid Markdown format (including headers, bullet points, and links).\"\n    }\n  },\n  \"required\": [\n    \"title\",\n    \"content\"\n  ]\n}"
